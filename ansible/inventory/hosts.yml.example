---
# cp hosts.yml.example hosts.yml  (hosts.yml is in .gitignore)
#
# Phase 1-2: ansible_host = public IP, ansible_user = root (key registered in hPanel)
# Phase 2+ : ansible_host = Tailscale IP (100.x) or "lab", ansible_user = ops
all:
  children:
    lab:
      hosts:
        vps.lab.example.com:
          ansible_host: 203.0.113.10
          ansible_user: root
          ansible_port: 22
