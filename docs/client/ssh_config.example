# ~/.ssh/config on the PC (Windows: C:\Users\<user>\.ssh\config). One host per user/company.
# Access only via the tailnet; lab.example.com resolves to the Tailscale IP.

Host vps-client-a
  HostName lab.example.com
  User client-a
  IdentityFile ~/.ssh/id_ed25519

Host vps-personal
  HostName lab.example.com
  User personal
  IdentityFile ~/.ssh/id_ed25519

Host vps-client-b
  HostName lab.example.com
  User client-b
  IdentityFile ~/.ssh/id_ed25519

Host vps-ops
  HostName lab.example.com
  User ops
  IdentityFile ~/.ssh/id_ed25519
